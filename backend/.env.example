# Local development only. Keep the API bound to localhost in this mode.
UCIF_AUTH_MODE=development
OBJECT_STORAGE_BACKEND=filesystem

# Production requires all of the following; values are supplied by the host's
# secret manager, never committed here.
# UCIF_AUTH_MODE=production
# UCIF_PROXY_SECRET=<random value with at least 32 characters; match Next.js>
# DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?sslmode=require
# OBJECT_STORAGE_BACKEND=s3
# S3_BUCKET=<private bucket name>
# AWS_REGION=<region>
# S3_ENDPOINT_URL=<optional S3-compatible endpoint>
# CORS_ORIGINS=https://<frontend-domain>
