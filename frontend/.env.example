# Public API base URL. Leave unset in production to use the same-origin /api/backend proxy.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Local FastAPI target for the Next.js /api/backend proxy.
# Set BACKEND_URL to the separately hosted FastAPI origin in each deployment environment.
BACKEND_URL=http://127.0.0.1:8000

# Shared only between the Next.js server and FastAPI server. Generate a random
# value (at least 32 bytes); never prefix with NEXT_PUBLIC_ or expose to browsers.
# UCIF_PROXY_SECRET=

# MongoDB-backed sign-in. Production requires an accessible database.
# MONGODB_URI=
# MONGODB_DB=ucif
# AUTH_SECRET=<random secret, at least 32 characters>
# ADMIN_SETUP_TOKEN=<temporary random secret, at least 32 characters>
